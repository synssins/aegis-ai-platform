# secrets / private
.env
.sanitize-patterns
backup/
docs/private/
# runtime data — never tracked
openwebui/
caddy/data/
caddy/config/
caddy/sites-enabled/
llm/
# ComfyUI store: weights, uploads, outputs, user data stay local. Only the model-path config and the pre-built
# Aegis workflows are tracked (regenerate with scripts/comfy-workflows.py).
comfyui/*
!comfyui/extra_model_paths.yaml
!comfyui/user/
comfyui/user/*
!comfyui/user/default/
comfyui/user/default/*
!comfyui/user/default/workflows/
comfyui/user/default/workflows/*
!comfyui/user/default/workflows/Aegis/
audio/
proxy/db/
proxy/audit/
__pycache__/
monitoring/data/
caddy/hub/state/
proxy/policy/
ops/requests/
ops/responses/
ops/archive/
proxy/evidence/
