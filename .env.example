# Copy to /data/ai-unified/.env and chmod 600. Never commit. Generate secrets with: openssl rand -hex 32

LITELLM_MASTER_KEY=sk-CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME

# Minted after first start: ./scripts/mint-key.sh mint openwebui mixtral 120 400000
OPENWEBUI_UPSTREAM_KEY=

# Hub admin credential: NOT in this file. The hub bootstraps a one-time password into its container log on first
# start (docker logs hub); first login forces a new password + MFA. Reset from the console: scripts/hub-reset-admin.sh

# Let's Encrypt contact (used only once a public hostname is applied from /hub)
ACME_EMAIL=you@example.com

# Safety classifier used before the hub has written a policy file (the hub's policy then decides). 8B is the recommended default.
VETO_GUARD_MODEL=llama-guard3:8b

# This host's LAN address (site address for the internal-CA site; hub cert probe target)
AEGIS_LAN_IP=192.0.2.10

# Monitoring profile (docker compose --profile monitoring up -d)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ENABLED=0

# Hub session signing + TOTP-secret encryption key (urlsafe base64, 32 bytes): python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
HUB_SECRET_KEY=CHANGE_ME

# Model the acceptance suite talks to (an exposed public name)
TEST_MODEL=mixtral

# (VETO_EVIDENCE_KEY removed 2026-09-24: zero retention — vetoed content is never stored, so there is nothing to encrypt.
#  Remove it from your .env and run scripts/evidence-purge.sh once to destroy any records created by earlier versions.)

# Model Open WebUI selects by default (an exposed public name)
OPENWEBUI_DEFAULT_MODEL=gemma3

# Public hostname (set from the hub; mirrored here so compose can build app URLs). chat.<host> and grafana.<host> need A records too.
AEGIS_PUBLIC_HOSTNAME=ai.example.com
