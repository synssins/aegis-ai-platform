# Aegis gateway — rev 4. CONSOLE-ONLY. Lives in caddy/conf/ (directory-mounted). Root-owned, read-only in containers.
# This file is the isolation layer: interconnects, routes, auth at the edge. The hub shows it
# read-only. The only web-modifiable Caddy config is /etc/caddy/sites-enabled/domain.caddy,
# written by the hub from a fixed template (public hostname + Cloudflare DNS-01).

{
    default_sni {$AEGIS_LAN_IP}
    email {$ACME_EMAIL}
    # The container's trust store is read-only; the LAN root CA is installed on clients instead.
    skip_install_trust
    admin localhost:2019 {
        origins localhost:2019 127.0.0.1:2019
    }
    # Client-auth policies make Caddy enforce strict SNI/Host matching, which breaks access by bare IP
    # (no SNI). Both sites request the same device CA, so relaxing it is safe here.
    servers {
        strict_sni_host insecure_off
    }
}

(common) {
    # Device identity: these headers are set ONLY from the TLS client certificate below. Anything a client
    # sends under these names is discarded before routing, so they cannot be forged.
    request_header -X-Device-Fingerprint
    request_header -X-Device-Subject

    request_body {
        max_size 32MB
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -X-Frame-Options
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
    }

    # OpenAI-compatible API for other services. Explicit allow-list; per-client virtual keys.
    @api path /v1/chat/completions /v1/completions /v1/embeddings /v1/models
    handle @api {
        reverse_proxy litellm:4000 {
            header_up -X-Forwarded-Host
            header_up -X-Real-IP
            header_up X-Device-Fingerprint {http.request.tls.client.fingerprint}
            header_up X-Device-Subject {http.request.tls.client.subject}
        }
    }
    handle /v1/* {
        respond 404
    }

    # Admin control centre (hub shares this container's network namespace). The hub enforces its own
    # authentication: argon2id passwords, mandatory TOTP, signed cookies, lockout. Nothing at the edge.
    @hub path /hub* /login* /logout /portal* /account* /setup* /chat/api/* /gallery*
    handle @hub {
        reverse_proxy localhost:9000 {
            header_up X-Device-Fingerprint {http.request.tls.client.fingerprint}
            header_up X-Device-Subject {http.request.tls.client.subject}
        }
    }

    # Public status page (GPU/CPU/memory load, resident models, service health — no sensitive data, no login).
    handle /status* {
        reverse_proxy localhost:9000 {
            header_up X-Device-Fingerprint {http.request.tls.client.fingerprint}
        }
    }

    # Monitoring — present when `--profile monitoring` is up (502 otherwise). Grafana has its own login.
    handle /grafana* {
        reverse_proxy grafana:3000
    }

    # Apps framework. TTS is plain reverse-proxy when the profile is up.
    handle /tts* {
        reverse_proxy fish-speech:7860
    }
    # ComfyUI HARD GATE — see docs/ROADMAP.md #8. Console-only change, after the safety gate is tested.
    # Image generation behind the hub's gate. The hub handles the calls that carry prompts, model choices and
    # outputs; everything else (UI assets, websocket progress, queue) is allowed only for a session the hub
    # vouches for (forward_auth). Uploads stay off until an input-image gate exists. Previews are disabled.
    @comfy_hub path /comfy/prompt /comfy/api/prompt /comfy/view /comfy/api/view /comfy/object_info* /comfy/api/object_info* /comfy/history* /comfy/api/history*
    handle @comfy_hub {
        reverse_proxy localhost:9000 {
            header_up X-Device-Fingerprint {http.request.tls.client.fingerprint}
            header_up X-Device-Subject {http.request.tls.client.subject}
        }
    }
    @comfy_upload path /comfy/upload* /comfy/api/upload*
    handle @comfy_upload {
        respond "image uploads are not enabled" 403
    }
    redir /comfy /comfy/ 308
    handle /comfy/* {
        forward_auth localhost:9000 {
            uri /hub/authz/comfy
            copy_headers X-Aegis-User
        }
        uri strip_prefix /comfy
        reverse_proxy comfyui:8188
    }

    log {
        output stdout
        format json
    }
}

# Default handlers differ per site: the LAN address keeps Open WebUI at /; the public hostname serves the portal.
(site) {
    import common
    header Content-Security-Policy "frame-ancestors 'self'"
    handle {
        reverse_proxy openwebui:8080
    }
}

# LAN access by IP with the internal CA. Client certificates are REQUESTED (optional): a device that has one
# is identified by its fingerprint; one that has none still connects. The hub decides what a missing
# certificate means (Access -> Devices).
{$AEGIS_LAN_IP} {
    tls internal {
        client_auth {
            mode request
            trusted_ca_cert_file /etc/caddy/sites-enabled/device-ca.pem
        }
    }
    import site
}

# Public hostname(s) — generated by the hub (Cloudflare DNS-01, no inbound ports required).
import /etc/caddy/sites-enabled/*.caddy
