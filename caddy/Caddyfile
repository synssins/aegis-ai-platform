# Aegis gateway — rev 2 (2026-09-24). CONSOLE-ONLY: root-owned, 0600, mounted read-only.
# The only web-modifiable piece of Caddy config is /etc/caddy/sites-enabled/domain.caddy,
# written from a fixed template by the hub service (see caddy/hub/hub.py).

{
    default_sni {$AEGIS_LAN_IP}
    email {$ACME_EMAIL}
    # Admin API stays on localhost:2019 inside this container's network namespace.
    # Only the hub service shares that namespace (network_mode: service:caddy).
    admin localhost:2019 {
        origins localhost:2019 127.0.0.1:2019
    }
}

# ---------------------------------------------------------------------------
# Shared site body. Imported by the IP site below and by sites-enabled/domain.caddy.
# ---------------------------------------------------------------------------
(site) {
    request_body {
        max_size 32MB
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
    }

    # OpenAI-compatible API for other services (operator requirement 2026-09-24, supersedes Gemini
    # rev1 "sole client"). Explicit allow-list; each client holds its own LiteLLM virtual key
    # (scripts/mint-key.sh). Everything else under /v1 (model/info, key mgmt, health) is 404 at the edge.
    @api path /v1/chat/completions /v1/completions /v1/embeddings /v1/models
    handle @api {
        reverse_proxy litellm:4000 {
            header_up -X-Forwarded-Host
            header_up -X-Real-IP
        }
    }
    handle /v1/* {
        respond 404
    }

    # Operator hub: cert status + domain/ACME configuration ONLY. Basic-auth at the edge.
    handle /hub* {
        basic_auth {
            admin {$HUB_ADMIN_PASSWORD_HASH}
        }
        reverse_proxy localhost:9000
    }

    # Monitoring (present only when docker-compose.monitoring.yml is up; 502 otherwise).
    handle /grafana* {
        reverse_proxy grafana:3000
    }

    handle {
        reverse_proxy openwebui:8080
    }

    log {
        output stdout
        format json
    }
}

# LAN access by IP with the internal CA.
{$AEGIS_LAN_IP} {
    tls internal
    import site
}

# Public-hostname site(s), if any. Files here are generated by the hub from a fixed template
# (or placed by an operator on the console). Glob matches nothing until then — that is fine.
import /etc/caddy/sites-enabled/*.caddy
